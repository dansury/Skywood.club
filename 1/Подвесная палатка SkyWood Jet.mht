.woocommerce-order-received ul.order_details li { -webkit-box-flex: 1; flex: 1 1 0%; margin-right: 2em; text-transform: uppercase; font-size: 0.715em; line-height: 1; border-right: 1px solid rgba(0, 0, 0, 0.1); list-style-type: none; padding: 15px !important; }

.woocommerce-order-received ul.order_details { list-style: none; margin: 0px 0px 3em !important; }

