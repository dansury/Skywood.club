@charset "utf-8";

* { zoom: 1; resize: none; -webkit-tap-highlight-color: transparent; }

body, html { position: relative; width: 100%; height: 100%; }

body { font-family: sans-serif; font-size: 14px; line-height: 1.4; color: rgb(34, 34, 34); }

textarea { resize: none; appearance: none; }

button, input:focus, textarea:focus { outline: none; }

a, a:active, a:hover, a:visited { color: rgb(34, 34, 34); text-decoration: underline; }

.cursor-default { cursor: default; }

p { white-space: pre-line; }

a.link-more { text-decoration: none; border-bottom: 1px dotted; }

a.link-more::after { content: " ‚Üì"; }

.button { display: flex; width: 100%; height: 18px; border: 0px; color: rgb(255, 255, 255); font-family: sans-serif; font-size: 14px; box-sizing: border-box; flex-direction: row; justify-content: center; align-items: center; background-color: rgb(73, 80, 86); border-radius: 5px; cursor: pointer; transition: opacity 0.15s linear; min-height: 44px; margin-bottom: 5px; }

@media sreen and (min-width: 1017px) {
  .app.-embedded .button { font-size: inherit; }
}

.button:last-child { margin-bottom: 0px; }

.button.disabled, .button[disabled] { background-color: rgb(204, 204, 204) !important; color: rgb(34, 34, 34) !important; }

.button:focus { opacity: 1; }

.app.-light .button { color: rgb(34, 34, 34); }

.app.-cursor .button:focus { opacity: 1; }

.app.-cursor .button:not([disabled]).hover, .app.-cursor .button:not([disabled]):hover { opacity: 0.85; }

.select { display: block; width: 100%; margin: 0px; padding: 0.6em 1.4em 0.5em 0.8em; border: 2px solid rgb(211, 211, 211); line-height: 1.5; max-width: 100%; box-sizing: border-box; font-size: 16px; border-radius: 5px; appearance: none; background-color: rgb(255, 255, 255); color: rgb(117, 117, 117); }

.select.-selected, .select:focus { color: rgb(34, 34, 34); }

.select.-invisible { padding-left: 0px; padding-right: 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 0px; }

.select:hover { border-color: rgb(221, 221, 221); }

.select:focus { border-color: rgb(170, 170, 170); box-shadow: rgba(59, 153, 252, 0.7) 0px 0px 1px 3px; outline: none; }

:root:lang(ar) .select, :root:lang(iw) .select, [dir="rtl"] .select { padding: 0.6em 0.8em 0.5em 1.4em; }

.svg-icon { display: block; position: relative; width: 100%; height: 100%; fill: currentcolor; line-height: 0; font-size: 0px; }

.svg-icon.-xs { width: 10px; height: 10px; }

.svg-icon.-sm { width: 16px; height: 16px; }

.svg-icon.-md { width: 18px; height: 18px; }

.svg-icon.-md2 { width: 24px; height: 24px; }

.svg-icon.-lg { width: 32px; height: 32px; }

.svg-icon.-xl { width: 64px; height: 64px; }

.button-link { display: inline-block; margin-right: 12px; color: rgb(187, 187, 187); width: 18px; height: 18px; }

.button-link:last-child { margin-right: 0px; }

.app.-cursor .button-link:hover { color: rgb(34, 34, 34); }

.app.-dark .button-link { color: rgb(173, 175, 179); }

.app.-dark.-cursor .button-link:hover { color: rgb(255, 255, 255); }

.app.-glass-light .button-link { color: rgba(0, 0, 0, 0.3); }

.app.-glass-dark .button-link:hover { color: rgb(255, 255, 255); }

.icon { transition: color 0.15s linear; }

.app.-embedded .button-link.-attachment { width: 24px; height: 24px; padding-top: 6px; box-sizing: initial; }

@media screen and (max-width: 1387px) {
  .app.-embedded .button-link.-attachment { width: 22px; height: 22px; padding-top: 5px; }
}

@media screen and (max-width: 1016px) {
  .app.-embedded .button-link.-attachment { width: 18px; height: 18px; padding-top: 4px; }
}

.attachment[data-v-7de97b94] { display: block; line-height: 0; font-size: 0px; }

.input[data-v-7de97b94] { opacity: 0; position: absolute; left: -200%; top: -200%; }

.composer[data-v-c1b8a24c] { display: flex; flex-flow: row; width: 100%; direction: ltr; }

.textarea[data-v-c1b8a24c] { display: block; font-family: sans-serif; color: rgb(34, 34, 34); font-size: 16px; border: 0px; margin: 0px; padding: 0px; width: 100%; height: 40px; min-height: 40px; max-height: 126px; text-align: left; background-color: initial; }

.submit-button[data-v-c1b8a24c] { display: block; width: 24px; height: 24px; border: 0px; cursor: pointer; color: rgb(34, 34, 34); background: transparent; transition: 0.15s linear; padding: 0px; }

.app.-cursor .submit-button[data-v-c1b8a24c]:hover { color: rgb(34, 34, 34); }

.app.-dark .submit-button[data-v-c1b8a24c] { color: rgb(173, 175, 179); }

.app.-dark.-cursor .submit-button[data-v-c1b8a24c]:hover { color: rgb(255, 255, 255); }

.fade-enter-active[data-v-c1b8a24c], .fade-leave-active[data-v-c1b8a24c] { transition: opacity 0.15s linear, color 0.15s linear; }

.fade-enter[data-v-c1b8a24c], .fade-leave-to[data-v-c1b8a24c] { opacity: 0; }

.textblock[data-v-c1b8a24c] { margin-left: 0px !important; margin-right: 15px !important; }

.app.-dark textarea[data-v-c1b8a24c] { color: rgb(255, 255, 255); }

.app.-embedded textarea[data-v-c1b8a24c] { height: 24px; min-height: 24px; font-size: 18px; }

.app.-embedded textarea[data-v-c1b8a24c]::placeholder { font-size: 18px; }

.app.-embedded .submit-button[data-v-c1b8a24c] { width: 36px; height: 36px; }

.app.-embedded .textblock[data-v-c1b8a24c] { padding-top: 20px; padding-bottom: 20px; }

