# ---- Сервер ----
PORT=3000
# Публичный адрес сайта (для callback-URL оплаты). На проде: https://skywood.club
BASE_URL=http://localhost:3000

# ---- Т-Банк (Тинькофф) Интернет-эквайринг ----
# Кабинет: https://developer.tinkoff.ru/eacq/intro/connection
# Реквизиты выдаются после подключения эквайринга к расчётному счёту ИП.
TINKOFF_TERMINAL_KEY=
TINKOFF_PASSWORD=
TINKOFF_API=https://securepay.tinkoff.ru/v2
# Система налогообложения для чека 54-ФЗ: osn | usn_income | usn_income_outcome | envd | esn | patent
TINKOFF_TAXATION=usn_income
# Ставка НДС для позиций чека: none | vat0 | vat10 | vat20 | vat110 | vat120
TINKOFF_VAT=none

# ---- СДЭК API v2 ----
# Договор и доступы: https://www.cdek.ru/ru/integration/
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=
CDEK_API=https://api.cdek.ru/v2
# Тестовый контур СДЭК: https://api.edu.cdek.ru/v2  (account=EMscd6r9JnFiQ3bLoyjJY6eM78JrJceI)

# Отправитель — склад/ПВЗ СДЭК, откуда уходят посылки.
# Код города СДЭК отправителя (Красногорск) и индекс — для расчёта тарифа.
CDEK_SENDER_CITY_CODE=
CDEK_SENDER_POSTAL_CODE=143405
# Код ПВЗ/склада СДЭК отправителя (shipment_point) для оформления заказа.
CDEK_SHIPMENT_POINT=
