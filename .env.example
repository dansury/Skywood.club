# Skywood.club — шаблон файла доступов.
#
# Скопируйте его в файл `.env` НА УРОВЕНЬ ВЫШЕ корня сайта — рядом с папкой
# public_html (в которую загружены index.html, api/ и остальные файлы):
#
#   /домашняя-папка/
#     .env          ← сюда
#     public_html/  ← сайт
#
# Тогда файл недоступен из браузера и не перезаписывается при обновлении
# через pull.php. Старое расположение (`.env` рядом с index.html) тоже
# работает, но менее безопасно.
#
# Реальные значения в git не коммитятся.

# ---- Сервер ----
# Публичный адрес сайта (для callback-URL оплаты), без слэша в конце.
# Пусто — определяется автоматически из запроса.
BASE_URL=https://skywood.club

# ---- Т-Банк (Тинькофф) Интернет-эквайринг ----
# Кабинет: https://developer.tinkoff.ru/eacq/intro/connection
# Реквизиты выдаются после подключения эквайринга к расчётному счёту ИП.
# Пока ключ и пароль пустые — оплата работает в демо-режиме (заглушка).
TINKOFF_TERMINAL_KEY=
TINKOFF_PASSWORD=
TINKOFF_API=https://securepay.tinkoff.ru/v2
# Система налогообложения для чека 54-ФЗ: osn | usn_income | usn_income_outcome | envd | esn | patent
TINKOFF_TAXATION=usn_income
# Ставка НДС для позиций чека: none | vat0 | vat10 | vat20 | vat22 | vat110 | vat120
TINKOFF_VAT=none

# ---- СДЭК API v2 ----
# Договор и доступы: https://www.cdek.ru/ru/integration/
# Пока аккаунт и пароль пустые — расчёт доставки работает на заглушках.
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=
CDEK_API=https://api.cdek.ru/v2
# Тестовый контур СДЭК: https://api.edu.cdek.ru/v2

# Отправитель — склад/ПВЗ СДЭК, откуда уходят посылки.
# Код города СДЭК и индекс — для расчёта тарифа.
CDEK_SENDER_CITY_CODE=
CDEK_SENDER_POSTAL_CODE=
# Код ПВЗ/склада отгрузки (shipment_point) для оформления заказа.
CDEK_SHIPMENT_POINT=

# ---- Админка /admin ----
# Пароль входа. Устаревший вариант ключа — строчными: adminpass.
ADMIN_PASS=
# Необязательный логин: если задан — на входе появится поле «Логин».
ADMIN_LOGIN=

# ---- Почта ----
# Письма уходят через PHP mail(). Все ключи необязательные.
# Получатель уведомлений о заказах (по умолчанию info@skywood.club).
ADMIN_EMAIL=
# Адрес и имя отправителя.
MAIL_FROM=
MAIL_FROM_NAME=
# 0 — полностью отключить отправку писем.
MAIL_ENABLED=1
